{
  "language": "jvm",
  "displayName": "Java / Kotlin (Spring Boot)",
  "manifestTriggers": ["pom.xml", "build.gradle", "build.gradle.kts"],
  "extensions": [".java", ".kt"],
  "frameworks": {
    "spring": {
      "routePatterns": [
        "@(GetMapping|PostMapping|PutMapping|DeleteMapping|PatchMapping|RequestMapping)\\s*\\(\\s*(?:value\\s*=\\s*)?(?:path\\s*=\\s*)?[\"']([^\"']*)[\"']",
        "@RestController",
        "@Controller"
      ],
      "handlerSignature": "public\\s+(?:ResponseEntity<[^>]+>|[A-Za-z0-9_<>]+)\\s+([a-zA-Z0-9_]+)\\s*\\(",
      "middlewarePatterns": ["@PreAuthorize\\(([^)]+)\\)", "@Secured\\(([^)]+)\\)", "@Valid", "@Validated"],
      "responsePatterns": [
        "ResponseEntity\\.(?:ok|status|created|badRequest)\\(([^)]*)\\)",
        "return\\s+new\\s+ResponseEntity<>"
      ]
    }
  },
  "controlFlow": {
    "errorHandling": [
      "try\\s*\\{[\\s\\S]*?\\}\\s*catch\\s*\\(([A-Za-z0-9_]+)\\s+\\w+\\)",
      "throw\\s+new\\s+([A-Za-z0-9_]+Exception)\\(([^)]*)\\)",
      "@ExceptionHandler\\(([^)]+)\\)"
    ],
    "asyncWorkflow": [
      "@Async",
      "CompletableFuture\\.supplyAsync",
      "@KafkaListener",
      "rabbitTemplate\\.convertAndSend"
    ]
  },
  "database": {
    "ormTriggers": ["org.springframework.data.jpa", "org.hibernate", "jakarta.persistence"],
    "queryMethods": [
      "findById", "findAll", "save", "saveAll", "deleteById", "count", "existsById", "@Query"
    ]
  },
  "externalCalls": [
    "restTemplate\\.(?:getForObject|postForEntity|exchange)\\(",
    "webClient\\.(?:get|post)\\(\\)",
    "feignClient"
  ]
}
